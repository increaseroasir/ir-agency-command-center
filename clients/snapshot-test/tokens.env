# snapshot-test/tokens.env
# Cloudflare Pages project env vars (plain text — set via Pages dashboard or wrangler)
# Secrets (META_CAPI_ACCESS_TOKEN, META_OFFLINE_WEBHOOK_SECRET, GHL_API_TOKEN,
#          GHL_LOCATION_ID, ADMIN_PASSWORD, TURNSTILE_SECRET_KEY) are set separately
#          via wrangler pages secret put OR Cloudflare dashboard → Settings → Variables

CLOUDFLARE_PAGES_PROJECT="snapshot-test"
CLIENT_NAME="Hot Tub Launch (Snapshot Test)"
CLIENT_WEBSITE_URL="https://snapshot-test.pages.dev"
CLIENT_PHONE="555-000-0000"
CLIENT_PHONE_E164="+15550000000"
ALLOWED_ORIGIN="https://snapshot-test.pages.dev"

# D1 — create via Cloudflare dashboard: Workers & Pages → D1 → Create database
# Name: snapshot-test-inventory
# Then bind it to the snapshot-test Pages project under Settings → Functions → D1 bindings
D1_DATABASE_NAME="snapshot-test-inventory"
D1_DATABASE_ID="FILL_IN_AFTER_CREATING_D1"

# R2 — not required for lead/CAPI testing; leave empty
R2_BUCKET_NAME=""
R2_PUBLIC_BUCKET_ID=""

# Meta
META_PIXEL_ID="1257695509378686"

# Offline CAPI stage values
META_VALUE_QUALIFIED="75"
META_VALUE_SCHEDULE="300"
META_VALUE_SHOWED="600"
LEAD_VALUE="0"
LEAD_CURRENCY="USD"

# GHL calendar — leave empty (request-mode)
GHL_BOOKING_CALENDAR_ID=""

# Secrets set via wrangler pages secret put (do NOT commit these values):
# GHL_API_TOKEN = pit-f71c18e5-b78b-4dd8-b9bc-511f166967c0
# GHL_LOCATION_ID = 8iqYr9YNiaTcGdEKl6UU
# META_CAPI_ACCESS_TOKEN = EAAORg...
# META_OFFLINE_WEBHOOK_SECRET = aLuYGUo6BfdorDKalvsx5BGrJKpC+GUvrEfPJmgXyDA=
# ADMIN_PASSWORD = (set your own)
# ADMIN_SESSION_SECRET = (generate: openssl rand -base64 32)
# TURNSTILE_SECRET_KEY = (leave empty or use CF test key 1x0000000000000000000000000000000AA)
